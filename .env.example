# ==============================================================================
# LedgerOne — Environment Configuration Example (.env.example)
# ==============================================================================

# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ledgerone_dev"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/ledgerone_dev"
NEON_BRANCH=development
APP_DB_ROLE=ledgerone_app
APP_DB_PASSWORD=your_secure_password

# Object Storage / S3
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_ENDPOINT_URL_S3=https://storage.endpoint.example.com
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=assets

# Platform Configuration
ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
