# ==============================================================================
# LedgerOne — Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Inference Provider Configuration
# ------------------------------------------------------------------------------
# Provider Selection: gemini | huggingface | openai | extractive | auto
LLM_PROVIDER=gemini

# Google AI Studio (Gemini) — Primary Provider
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GOOGLE_API_KEY=your_gemini_api_key_alias_optional
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Inference Providers — Alternative Provider
HF_TOKEN=your_huggingface_user_access_token
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_PROVIDER=auto
HF_ENDPOINT_URL=

# OpenAI / Compatible Endpoint — Alternative Provider
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Generation Hyperparameters (Empirically Calibrated Defaults)
LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 2. Database Connection (Neon PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-example-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=development
APP_DB_ROLE=ledgerone_app
APP_DB_PASSWORD=your_secure_db_password

# ------------------------------------------------------------------------------
# 3. Object Storage / S3 (Neon Lakebase S3 or AWS S3)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_s3_access_key_id
AWS_SECRET_ACCESS_KEY=your_s3_secret_access_key
AWS_ENDPOINT_URL_S3=https://storage.endpoint.example.com
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=assets

# ------------------------------------------------------------------------------
# 4. Redis Cache & Task Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=ledgerone-super-secret-key-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 6. Platform Runtime Configuration
# ------------------------------------------------------------------------------
ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
WORKER_ENABLED=true
